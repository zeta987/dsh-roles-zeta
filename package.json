{
  "name": "dsh-roles-zeta",
  "version": "0.2.0",
  "type": "module",
  "description": "Role-based subagent delegation for DeepSeek Harness: one delegate tool over a folder of role files, with a roster that ships and stays overridable",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "ai-agents",
    "subagent",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "roles",
    "cordis.patch.yml",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeta987/dsh-roles-zeta.git"
  },
  "homepage": "https://github.com/zeta987/dsh-roles-zeta#readme",
  "bugs": {
    "url": "https://github.com/zeta987/dsh-roles-zeta/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-tools": "*",
    "yaml": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "dependencies": {}
}
